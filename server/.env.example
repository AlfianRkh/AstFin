PORT=8080

# Database Configuration (PostgreSQL)
DB_DRIVER=$dbdriver
DB_HOST=$dbhost
DB_PORT=$dbport
DB_USER=$dbuser
DB_PASSWORD=$dbpasswrd
DB_NAME=$dbname
DB_SSLMODE=disable

# Optional: Direct PostgreSQL Connection URL (uncomment to use)
# DATABASE_URL=$dburl
# JWT & Security Configuration
JWT_SECRET=$jwtsecret
JWT_EXPIRES_HOURS=24
CORS_ORIGIN=*
